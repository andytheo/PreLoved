# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/preloved?schema=public"

# NextAuth / application security
# Production: https://preloved-eight.vercel.app
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
VERIFICATION_SECRET="replace-with-a-different-long-random-secret"
RATE_LIMIT_SECRET="replace-with-another-long-random-secret"

# Email verification and site contact (Resend)
RESEND_API_KEY="re_..."
VERIFICATION_EMAIL_FROM="PreLoved <verify@your-domain.example>"
CONTACT_EMAIL_FROM="PreLoved <contact@your-domain.example>"
CONTACT_EMAIL_TO="you@your-domain.example"

# SMS verification / SMS 2FA (Twilio)
# Use an SMS-capable Twilio sender and enable the destination countries you support.
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+15555550123"

# Persistent image storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="..."
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."
